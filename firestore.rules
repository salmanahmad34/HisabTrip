rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTripMember(tripId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds
      );
    }

    function isTripCreator(tripId) {
      return isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds != null &&
        (request.auth.uid in request.resource.data.memberIds);

      allow update: if isAuthenticated() && (
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        resource.data.createdBy == request.auth.uid
      );

      allow delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;

      // Subcollections
      match /members/{memberId} {
        allow read, write: if isAuthenticated() && (isTripMember(tripId) || isTripCreator(tripId));
      }

      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated() && (isTripMember(tripId) || isTripCreator(tripId));
      }

      match /contributions/{contribId} {
        allow read, write: if isAuthenticated() && (isTripMember(tripId) || isTripCreator(tripId));
      }

      match /settlements/{settleId} {
        allow read, write: if isAuthenticated() && (isTripMember(tripId) || isTripCreator(tripId));
      }

      match /audit_logs/{logId} {
        allow read, write: if isAuthenticated() && (isTripMember(tripId) || isTripCreator(tripId));
      }
    }
  }
}
